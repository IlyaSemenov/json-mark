{
  "name": "@ilyasemenov/json-mark",
  "version": "1.0.5",
  "description": "Serialize custom types in JSON with tagged strings.",
  "homepage": "https://github.com/IlyaSemenov/json-mark#readme",
  "bugs": "https://github.com/IlyaSemenov/json-mark/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/json-mark.git"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "release": "changesets-release",
    "test": "bun test",
    "types": "bun check && bun check -p tests"
  },
  "dependencies": {
    "uint8array-extras": "^1.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@ilyasemenov/oxc-config": "^0.1.3",
    "@tsconfig/bun": "^1.0.12",
    "@types/bun": "^1.4.4",
    "changesets-release": "^2.1.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
