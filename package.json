{
  "name": "@ilyasemenov/json-mark",
  "version": "1.0.5",
  "description": "Serialize custom types in JSON with tagged strings.",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "https://github.com/IlyaSemenov/json-mark"
  },
  "files": [
    "!src/**/*.test.*",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "types": "bun check && bun check -p tests"
  },
  "dependencies": {
    "uint8array-extras": "^1.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@ilyasemenov/oxc-config": "^0.1.3",
    "@tsconfig/bun": "^1.0.12",
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsdown": "^0.15.9",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.4"
}
